{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "slide-ng": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "loader": {
              ".ttf": "file"
            },
            "allowedCommonJsDependencies": [
              "@braintree/sanitize-url",
              "cytoscape-cose-bilkent",
              "cytoscape-fcose",
              "dayjs",
              "dayjs/plugin/advancedFormat.js",
              "dayjs/plugin/customParseFormat.js",
              "dayjs/plugin/duration.js",
              "dayjs/plugin/isoWeek.js",
              "elkjs/lib/elk.bundled.js"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/slides/generated/remote-assets",
                "output": "remote-assets"
              },
              {
                "glob": "**/*",
                "input": "src/slides/generated/public"
              },
              {
                "glob": "**/*",
                "input": "src/slides/generated/local-assets",
                "output": "_local"
              }
            ],
            "styles": [
              "src/styles/reset.css",
              "src/slides/generated/uno.css",
              "src/slides/generated/features.css",
              "src/styles.css",
              "src/slides/generated/theme.css"
            ],
            "index": "src/slides/generated/index.html"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/app/dev/load-highlighter.ts",
                  "with": "src/app/dev/load-highlighter.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "6MB",
                  "maximumError": "100MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "64kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": true },
                "fonts": { "inline": false }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.mjs"
          },
          "configurations": {
            "production": {
              "buildTarget": "slide-ng:build:production"
            },
            "development": {
              "buildTarget": "slide-ng:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "include": ["src/**/*.spec.ts", "../scripts/**/*.spec.ts"]
          }
        }
      }
    }
  }
}
