/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": []
  },
  // Only main.ts is listed: everything the deck reaches by imports is compiled, and nothing else.
  // That way Monaco's workers are built only for decks that use an editor. css.d.ts types the stylesheet Monaco's chunk imports as text.
  "files": ["src/main.ts", "src/app/code/monaco/css.d.ts"],
  // Layouts and components are listed too, used or not: when the last slide that binds an input of one stops using it, the
  // dev server's next build failed with "Program does not contain ….ngtypecheck.ts" (an Angular incremental build problem).
  // Not src/app/code: listing the editor would build Monaco's workers for every deck.
  "include": [
    "src/app/builtin/*.ts",
    "src/app/drag/*.ts",
    "src/app/layouts/*.ts",
    "src/slides/generated/roots/*/layouts/*.ts",
    "src/slides/generated/roots/*/components/*.ts"
  ],
  "exclude": ["**/*.spec.ts"]
}
