{
  "name": "@slide-ng/core",
  "version": "1.0.0",
  "description": "Presentations written in markdown, with Angular templates inside. A Slidev port for Angular.",
  "keywords": [
    "slides",
    "presentation",
    "markdown",
    "angular",
    "slidev",
    "slide-deck"
  ],
  "author": "Erkam Yaman (https://github.com/erkamyaman)",
  "license": "MIT",
  "homepage": "https://github.com/slide-ng/slide.ng#readme",
  "bugs": {
    "url": "https://github.com/slide-ng/slide.ng/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slide-ng/slide.ng.git"
  },
  "bin": {
    "slide-ng": "./bin/slide-ng.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "public",
    "template",
    "skills",
    "angular.json",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.worker.json",
    "uno.config.mjs",
    "proxy.conf.mjs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "!**/*.spec.ts",
    "!src/slides/generated",
    "!docs/screenshots",
    "!docs/contributing",
    "!scripts/resign-history.sh",
    "!scripts/commit-message.mjs",
    "!scripts/check-skills-drift.mjs",
    "!scripts/update-skills-hash.mjs"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "ng": "ng",
    "generate": "node scripts/generate.mjs",
    "start": "node scripts/dev.mjs",
    "build": "npm run generate && ng build",
    "test": "npm run generate && ng test --no-watch",
    "test:e2e": "node tests/e2e/run.mjs && node tests/e2e/showcase.mjs && node tests/e2e/phase2.mjs && node tests/e2e/phase3.mjs && node tests/e2e/phase4.mjs && node tests/e2e/phase5.mjs && node tests/e2e/i18n.mjs",
    "test:dev": "node tests/e2e/dev-hmr.mjs && node tests/e2e/dev-server.mjs",
    "test:skills": "node tests/skills/verify-samples.mjs",
    "check:skills": "node scripts/check-skills-drift.mjs",
    "update:skills-hash": "node scripts/update-skills-hash.mjs",
    "screenshots": "node tests/e2e/screenshots.mjs && node tests/e2e/screenshots-features.mjs && node tests/e2e/screenshots-phase3.mjs",
    "test:export": "node tests/export/run.mjs && node tests/export/sandbox-filter.mjs && node tests/export/build.mjs && node tests/export/theme.mjs && node tests/export/example-themes.mjs && node tests/export/scaffold.mjs && node tests/export/mcp.mjs && node tests/export/offline.mjs && node tests/export/offline-net.mjs && node tests/skills/verify-samples.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@cantoo/pdf-lib": "^2.11.1",
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@shikijs/magic-move": "^4.5.0",
    "@shikijs/twoslash": "^4.5.0",
    "@slidev/parser": "^53.0.0",
    "@unocss/core": "^66.11.0",
    "@unocss/preset-icons": "^66.11.0",
    "@unocss/preset-wind3": "^66.11.0",
    "@unocss/reset": "^66.11.0",
    "drauu": "^1.0.0",
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "magic-string": "^1.4.1",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "rough-notation": "^0.5.1",
    "rxjs": "~7.8.0",
    "shiki": "^4.5.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  }
}
